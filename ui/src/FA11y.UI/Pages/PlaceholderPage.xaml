<pages:PageBase x:Class="FA11y.UI.Pages.PlaceholderPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:pages="clr-namespace:FA11y.UI.Pages"
                xmlns:c="clr-namespace:FA11y.UI.Controls">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="{StaticResource HeadingFontSize}" FontWeight="SemiBold"
                   Margin="0,0,0,12" />
        <c:ReadableText x:Name="Explanation" MaxWidth="560" Foreground="{StaticResource TextSecondary}" />
        <c:IconButton x:Name="OpenButton" Margin="0,12,0,0" HorizontalAlignment="Left" Variant="primary"
                      Click="OnOpenClick" />
    </StackPanel>
</pages:PageBase>
