<pages:PageBase x:Class="FA11y.UI.Pages.QuestsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:pages="clr-namespace:FA11y.UI.Pages"
                xmlns:c="clr-namespace:FA11y.UI.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Quests and passes" FontSize="{StaticResource HeadingFontSize}"
                   FontWeight="SemiBold" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <c:ReadableText x:Name="Message" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                            Foreground="{StaticResource TextSecondary}" />
            <TabControl x:Name="Tabs" Visibility="Collapsed" AutomationProperties.Name="Quests and passes sections"
                        SelectionChanged="OnTabChanged">
                <TabItem x:Name="QuestsTab" Header="Quests" AutomationProperties.Name="Quests" />
            </TabControl>
            <ContentControl x:Name="SubView" Visibility="Collapsed" IsTabStop="False" />
        </Grid>
    </Grid>
</pages:PageBase>
