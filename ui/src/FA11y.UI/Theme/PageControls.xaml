<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:FA11y.UI.Controls">

    <!-- Controls for pages with tabs, radio choices and long lists (Social, Locker). -->

    <!-- Tabs inside a page. Ctrl+Tab and Ctrl+Shift+Tab switch tabs (the window leaves those keys to the
         tab control when focus is inside it); Left and Right switch while a tab has focus. -->
    <!-- A long list: one tab stop, arrows move inside it, and only the rows on screen exist. -->
    <Style x:Key="PageList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
        <Setter Property="TextSearch.TextPath" Value="Name" />
        <Setter Property="IsTextSearchEnabled" Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
