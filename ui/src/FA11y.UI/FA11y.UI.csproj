<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FA11y.UI</RootNamespace>
    <AssemblyName>FA11y.UI</AssemblyName>
    <ApplicationIcon>..\..\..\assets\images\fa11y.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <AssemblyTitle>FA11y</AssemblyTitle>
    <Product>FA11y</Product>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only for the tray icon; its implicit usings would clash with WPF's type names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\..\assets\images\fa11y.ico" Link="Assets\fa11y.ico" />
    <Resource Include="..\..\..\assets\images\fa11y_logo.png" Link="Assets\fa11y_logo.png" />
  </ItemGroup>

</Project>
