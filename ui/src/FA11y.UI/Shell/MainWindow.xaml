<Window Style="{StaticResource AppWindow}" x:Class="FA11y.UI.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FA11y.UI.Controls"
        xmlns:local="clr-namespace:FA11y.UI.Shell"
        Title="FA11y - Home" Width="980" Height="660" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/fa11y.ico">
    <Grid>
      <Grid x:Name="MainArea">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBg}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,0,18">
                <c:HiddenImage Width="32" Height="32" Source="pack://application:,,,/Assets/fa11y_logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <c:HiddenText Text="FA11y" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{StaticResource BrandFontSize}" FontWeight="SemiBold" />
            </StackPanel>
            <!-- Like the Categories list in NVDA's settings: a label, then the list it names (Alt+P). -->
            <c:FieldLabel x:Name="PagesLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Content="_Pages:"
                          Target="{Binding ElementName=Sidebar}" Margin="18,0,8,4"
                          FontSize="{StaticResource SmallFontSize}" FontWeight="SemiBold"
                          Foreground="{StaticResource TextMuted}" />
            <c:NavList x:Name="Sidebar" AutomationProperties.LabeledBy="{Binding ElementName=PagesLabel}"
                       AutomationProperties.AccessKey="Alt+P" />
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource CardBorder}" />

        <Grid x:Name="PageHost" Grid.Column="2" Background="{StaticResource WindowBg}" />
      </Grid>
      <!-- First-run setup replaces the sidebar and pages until it is finished or skipped. -->
      <local:SetupView x:Name="Setup" Visibility="Collapsed" />
      <!-- Shown until the core says startup is done, then fades into the sidebar and pages. -->
      <local:StartupView x:Name="Startup" />
    </Grid>
</Window>
