<UserControl x:Class="FA11y.UI.Shell.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FA11y.UI.Controls"
             Background="{StaticResource WindowBg}">
    <UserControl.Resources>
        <!-- A quarter-circle arc in the accent color that turns while FA11y starts. -->
        <Style x:Key="SpinnerArc" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
            <Setter Property="StrokeThickness" Value="3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Data" Value="M 16,2 A 14,14 0 0 1 30,16" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Canvas Width="32" Height="32" HorizontalAlignment="Center">
            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="28" Height="28" Stroke="{StaticResource CardBorder}"
                     StrokeThickness="3" />
            <Path Style="{StaticResource SpinnerArc}" Width="32" Height="32" />
        </Canvas>
        <ProgressBar x:Name="Bar" Width="320" Margin="0,20,0,0" Focusable="True" IsTabStop="True"
                     AutomationProperties.Name="Starting FA11y" />
        <c:HiddenText x:Name="Status" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                      TextWrapping="Wrap" MaxWidth="320" FontSize="{StaticResource SmallFontSize}"
                      Foreground="{StaticResource TextMuted}" />
    </StackPanel>
</UserControl>
