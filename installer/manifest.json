{
  "schema": 1,
  "repo": "GreenBeanGravy/FA11y",
  "branch": "overhaul",
  "python": {
    "version": "3.12.9",
    "url": "https://www.nuget.org/api/v2/package/python/3.12.9",
    "sha256": "b7240e3117d94dc2446c4b1250e31306adc817934706937d0992c78f937487ba",
    "archive_subdir": "tools"
  },
  "requirements": "requirements.lock",
  "sync": {
    "exclude": [
      ".github/",
      ".gitignore",
      "installer/cmd/",
      "installer/internal/",
      "installer/go.mod",
      "installer/go.sum",
      "installer/manifest.json",
      "tests/",
      "tools/",
      "docs/",
      "ui/src/",
      "ui/tests/",
      "ui/tools/",
      "ui/FA11y.UI.sln",
      "ui/.gitignore",
      "whls/",
      "pytest.ini",
      "CONTRIBUTING.md",
      "legendary.exe",
      "updater.py"
    ],
    "add_only": [
      "assets/sounds/"
    ]
  },
  "components": [
    {
      "id": "dotnet8",
      "name": ".NET 8 Runtime",
      "reason": "Needed by mouse passthrough (FakerInputWrapper.dll targets .NET 8).",
      "detect": {
        "path_glob": "%ProgramFiles%\\dotnet\\shared\\Microsoft.NETCore.App\\8.*\\System.Runtime.dll"
      },
      "download": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.31/dotnet-runtime-8.0.31-win-x64.exe",
        "sha512": "2dc2f346a4bcb53ab15ab6ab84348c02eb31b0a3d4e8e06aac73b4c89f1b001af01943ed4c5735fa5585f1dd731a942d2034577dfe937f4454367ff2d6edf929"
      },
      "install": {
        "type": "exe",
        "args": [
          "/install",
          "/quiet",
          "/norestart"
        ],
        "success_codes": [
          0,
          1641,
          3010
        ]
      },
      "elevate": true
    },
    {
      "id": "windowsdesktop10",
      "name": ".NET 10 Desktop Runtime",
      "reason": "Needed by the FA11y window.",
      "detect": {
        "path_glob": "%ProgramFiles%\\dotnet\\shared\\Microsoft.WindowsDesktop.App\\10.*\\PresentationFramework.dll"
      },
      "download": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/10.0.12/windowsdesktop-runtime-10.0.12-win-x64.exe",
        "sha512": "0b907e9312867172a4eb82f4b5ab3f7c2d25e27d8349546d77eeb5d5b8cbecab9ebebfed189b13e9669dc578d892756c548366da539d47b3ddac5efcb7ae72fe"
      },
      "install": {
        "type": "exe",
        "args": [
          "/install",
          "/quiet",
          "/norestart"
        ],
        "success_codes": [
          0,
          1641,
          3010
        ]
      },
      "elevate": true
    },
    {
      "id": "fakerinput",
      "name": "FakerInput driver",
      "reason": "Virtual mouse and keyboard driver used by mouse passthrough.",
      "detect": {
        "uninstall_display_name": "FakerInput"
      },
      "download": {
        "url": "https://github.com/Ryochan7/FakerInput/releases/download/v0.1.0/FakerInput_0.1.0_x64.msi",
        "sha256": "30cf218b624740a91be4fcca3adfb4550ba8cc8f31ac9625fe39d238e64d13ea"
      },
      "install": {
        "type": "msi",
        "args": [
          "/qn",
          "/norestart"
        ],
        "success_codes": [
          0,
          1641,
          3010
        ]
      },
      "elevate": true
    },
    {
      "id": "legendary",
      "name": "Legendary",
      "reason": "Epic Games login and account features.",
      "detect": {
        "path_glob": "%FA11Y_FILES%\\legendary.exe"
      },
      "download": {
        "url": "https://github.com/derrod/legendary/releases/download/0.20.34/legendary.exe",
        "sha256": "01ea22ea51749f46a0019657f64fc0d34429fb7cbf9b590c0848c0e0bd9c1f07"
      },
      "install": {
        "type": "file",
        "dest": "legendary.exe"
      },
      "elevate": false
    }
  ]
}
